{
  "name": "Client Value Review",
  "description": "Run by the Client Value Review portal form: builds a branded 30, 60 or 90 day value review from PSA ticket stats, adds Endpoint Lifecycle Planner cards and a QBR prep card, then posts the review to the client's Report Archives.",
  "version": "1.0.0",
  "exportedFrom": "tenant workflow v0.0.14",
  "definition": {
    "schemaVersion": 1,
    "activities": [
      {
        "id": "start",
        "name": "Start",
        "type": "start",
        "position": {
          "x": 80,
          "y": 80
        },
        "properties": {
          "webhookEnabled": false
        }
      },
      {
        "id": "build-review",
        "name": "Build Review Data",
        "type": "powershell-script",
        "position": {
          "x": 219.35483870967744,
          "y": 321.2903225806452
        },
        "properties": {
          "script": "@file:build-review.ps1",
          "timeoutSeconds": 1200,
          "retryCount": 0,
          "parameters": [
            {
              "name": "trigger",
              "expression": "{{ nodes.trigger.output }}"
            }
          ],
          "aiExtensions": [
            "connectwise-manage"
          ]
        }
      },
