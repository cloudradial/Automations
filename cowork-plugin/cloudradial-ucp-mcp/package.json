{
  "name": "@cloudradial/ucp-mcp",
  "version": "0.1.0",
  "description": "MCP server for the CloudRadial UCP Portal — exposes the CloudRadial API V2 as MCP tools for Claude Desktop, Claude Code, and other MCP clients.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cloudradial-ucp-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist-bundle/index.mjs --external:@napi-rs/keyring",
    "test": "esbuild test/tools.test.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/test/tools.test.mjs --external:@napi-rs/keyring --log-level=warning && node dist/test/tools.test.mjs && node ../cloudradial-ucp/scripts/check-skills.mjs",
    "test:live": "esbuild test/live-check.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/test/live-check.mjs --external:@napi-rs/keyring --log-level=warning && node dist/test/live-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "adm-zip": "^0.5.16",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudradial/helpers"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cloudradial",
    "claude"
  ]
}
