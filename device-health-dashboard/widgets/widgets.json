  "Automatic Remediation",
  "<div style=\"font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;padding:4px 6px;color:#0f1f3d;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;margin-bottom:8px;\">Fixed automatically by Datto RMM</div><div style=\"display:flex;gap:10px;margin-bottom:8px;\"><div style=\"flex:1;background:#f8fafc;border:1px solid #eef2f7;border-left:4px solid #22c55e;border-radius:10px;padding:8px 12px;\"><div style=\"font-size:11px;color:#64748b;\">Fixes this week</div><div style=\"font-size:20px;font-weight:700;color:#0f1f3d;\">@DHFixWeek</div></div><div style=\"flex:1;background:#f8fafc;border:1px solid #eef2f7;border-left:4px solid #14b8a6;border-radius:10px;padding:8px 12px;\"><div style=\"font-size:11px;color:#64748b;\">Success rate</div><div style=\"font-size:20px;font-weight:700;color:#0f1f3d;\">@DHFixRate%</div></div><div style=\"flex:1;background:#f8fafc;border:1px solid #eef2f7;border-left:4px solid #3b82f6;border-radius:10px;padding:8px 12px;\"><div style=\"font-size:11px;color:#64748b;\">Last run</div><div style=\"font-size:20px;font-weight:700;color:#0f1f3d;\">@DHFixLast</div></div></div><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tbody><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;font-size:12px;\">@DHFixWhen1</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;font-weight:600;color:#0f1f3d;\">@DHFixDev1</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#334155;\">@DHFixWhat1</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;\"><span style=\"font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:@DHFixBg1;color:@DHFixFg1;white-space:nowrap;\">@DHFixRes1</span></td></tr><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;font-size:12px;\">@DHFixWhen2</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7