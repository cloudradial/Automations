  "Needs Attention",
  "<div style=\"font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;padding:4px 6px;color:#0f1f3d;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;margin-bottom:6px;\">Devices that need attention</div><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tbody><tr style=\"text-align:left;color:#94a3b8;font-size:11px;text-transform:uppercase;letter-spacing:.06em;\"><th style=\"padding:4px 8px;\">Device</th><th style=\"padding:4px 8px;\">Issue</th><th style=\"padding:4px 8px;\">Last seen</th><th style=\"padding:4px 8px;\">Priority</th></tr><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;font-weight:600;color:#0f1f3d;\">@DHNeedName1</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#334155;\">@DHNeedIssue1</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;\">@DHNeedSeen1</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;\"><span style=\"font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:@DHNeedBg1;color:@DHNeedFg1;white-space:nowrap;\">@DHNeedSev1</span></td></tr><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;font-weight:600;color:#0f1f3d;\">@DHNeedName2</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#334155;\">@DHNeedIssue2</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;\">@DHNeedSeen2</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;\"><span style=\"font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:@DHNeedBg2;color:@DHNeedFg2;white-space:nowrap;\">@DHNeedSev2</span></td></tr><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;font-weight:600;color:#0f1f3d;\">@DHNeedName3</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#334155;\">@DHNeedIssue3</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;\">@DHNeedSeen3</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;\"><span style=\"font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:@DHNeedBg3;color:@DHNeedFg3;white-space:nowrap;\">@DHNeedSev3</span></td></tr><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;font-weight:600;color:#0f1f3d;\">@DHNeedName4</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#334155;\">@DHNeedIssue4</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;\">@DHNeedSeen4</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;\"><span style=\"font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:@DHNeedBg4;color:@DHNeedFg4;white-space:nowrap;\">@DHNeedSev4</span></td></tr><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;font-weight:600;color:#0f1f3d;\">@DHNeedName5</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#334155;\">@DHNeedIssue5</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;\">@DHNeedSeen5</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;\"><span style=\"font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:@DHNeedBg5;color:@DHNeedFg5;white-space:nowrap;\">@DHNeedSev5</span></td></tr><tr><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;font-weight:600;color:#0f1f3d;\">@DHNeedName6</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#334155;\">@DHNeedIssue6</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;color:#64748b;white-space:nowrap;\">@DHNeedSeen6</td><td style=\"padding:10px 8px;border-bottom:1px solid #eef2f7;\"><span style=\"font-size:11px;font-weight:700;padding:3px 9px;border-radius:999px;background:@DHNeedBg6;color:@DHNeedFg6;white-space:nowrap;\">@DHNeedSev6</span></td></tr></tbody></table></div>"
