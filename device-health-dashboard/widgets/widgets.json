[
 [
  "Device Health Overview",
  "<div style=\"font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;padding:4px 6px;color:#0f1f3d;\"><div style=\"background:linear-gradient(120deg,#0f1f3d 0%,#1e3a8a 55%,#0d9488 100%);border-radius:12px;padding:11px 18px;color:#ffffff;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;\"><div style=\"display:flex;align-items:center;gap:14px;\"><div style=\"width:64px;height:64px;border-radius:50%;background:conic-gradient(@DHScoreColor 0% @DHScoreNum%,rgba(255,255,255,.2) @DHScoreNum% 100%);display:flex;align-items:center;justify-content:center;flex:none;\"><div style=\"width:48px;height:48px;border-radius:50%;background:#0f1f3d;display:flex;flex-direction:column;align-items:center;justify-content:center;\"><div style=\"font-size:19px;font-weight:700;line-height:1;\">@DHScoreNum</div><div style=\"font-size:9px;opacity:.8;\">@DHScoreLabel</div></div></div><div><div style=\"font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.8;\">@CompanyName</div><div style=\"font-size:22px;font-weight:700;margin-top:2px;\">Device Health</div><div style=\"font-size:12px;opacity:.85;margin-top:2px;\">Live from @DHSource</div></div></div><span style=\"display:inline-block;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.35);padding:5px 11px;border-radius:999px;font-size:11px;font-weight:600;\">Updated @DHUpdated</span></div><div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px;\"><div style=\"background:#ffffff;border:1px solid #e3e8f0;border-radius:12px;padding:9px 12px;box-shadow:0 2px 8px rgba(15,31,61,.06);border-top:4px solid #0ea5e9;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;\">Managed devices</div><div style=\"font-size:22px;font-weight:700;color:#0f1f3d;margin:2px 0 1px;\">@DHDevices</div><div style=\"font-size:12px;color:#64748b;\">@DHNoteDevices</div></div><div style=\"background:#ffffff;border:1px solid #e3e8f0;border-radius:12px;padding:9px 12px;box-shadow:0 2px 8px rgba(15,31,61,.06);border-top:4px solid #22c55e;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;\">Online now</div><div style=\"font-size:22px;font-weight:700;color:#0f1f3d;margin:2px 0 1px;\">@DHOnline</div><div style=\"font-size:12px;color:#64748b;\">@DHNoteOnline</div></div><div style=\"background:#ffffff;border:1px solid #e3e8f0;border-radius:12px;padding:9px 12px;box-shadow:0 2px 8px rgba(15,31,61,.06);border-top:4px solid #14b8a6;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;\">Fully patched</div><div style=\"font-size:22px;font-weight:700;color:#0f1f3d;margin:2px 0 1px;\">@DHPatchPct%</div><div style=\"font-size:12px;color:#64748b;\">@DHNotePatch</div></div><div style=\"background:#ffffff;border:1px solid #e3e8f0;border-radius:12px;padding:9px 12px;box-shadow:0 2px 8px rgba(15,31,61,.06);border-top:4px solid #8b5cf6;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;\">Antivirus OK</div><div style=\"font-size:22px;font-weight:700;color:#0f1f3d;margin:2px 0 1px;\">@DHAvPct%</div><div style=\"font-size:12px;color:#64748b;\">@DHNoteAv</div></div><div style=\"background:#ffffff;border:1px solid #e3e8f0;border-radius:12px;padding:9px 12px;box-shadow:0 2px 8px rgba(15,31,61,.06);border-top:4px solid #f59e0b;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;\">Reboot pending</div><div style=\"font-size:22px;font-weight:700;color:#0f1f3d;margin:2px 0 1px;\">@DHReboot</div><div style=\"font-size:12px;color:#64748b;\">@DHNoteReboot</div></div><div style=\"background:#ffffff;border:1px solid #e3e8f0;border-radius:12px;padding:9px 12px;box-shadow:0 2px 8px rgba(15,31,61,.06);border-top:4px solid #ef4444;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;\">Not checking in</div><div style=\"font-size:22px;font-weight:700;color:#0f1f3d;margin:2px 0 1px;\">@DHStale</div><div style=\"font-size:12px;color:#64748b;\">@DHNoteStale</div></div></div></div>"
 ],
 [
  "Patch Compliance",
  "<div style=\"font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;padding:4px 6px;color:#0f1f3d;display:flex;gap:22px;flex-wrap:wrap;\"><div style=\"flex:2;min-width:280px;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;margin-bottom:6px;\">Patch status by device</div><div style=\"display:flex;align-items:baseline;gap:8px;margin-bottom:12px;\"><span style=\"font-size:40px;font-weight:800;color:#0f1f3d;line-height:1;\">@DHPatchPct%</span><span style=\"font-size:12px;color:#64748b;\">fully patched</span></div><div style=\"margin:0 0 13px;\"><div style=\"display:flex;justify-content:space-between;font-size:13px;color:#334155;margin-bottom:5px;\"><span><span style=\"display:inline-block;width:10px;height:10px;border-radius:3px;background:#22c55e;margin-right:8px;\"></span>Fully patched</span><b>@DHPatchNFull</b></div><div style=\"height:12px;background:#f1f5f9;border-radius:6px;\"><div style=\"width:@DHPatchBarFull%;height:12px;background:#22c55e;border-radius:6px;\"></div></div></div><div style=\"margin:0 0 13px;\"><div style=\"display:flex;justify-content:space-between;font-size:13px;color:#334155;margin-bottom:5px;\"><span><span style=\"display:inline-block;width:10px;height:10px;border-radius:3px;background:#3b82f6;margin-right:8px;\"></span>Approved, pending install</span><b>@DHPatchNPend</b></div><div style=\"height:12px;background:#f1f5f9;border-radius:6px;\"><div style=\"width:@DHPatchBarPend%;height:12px;background:#3b82f6;border-radius:6px;\"></div></div></div><div style=\"margin:0 0 13px;\"><div style=\"display:flex;justify-content:space-between;font-size:13px;color:#334155;margin-bottom:5px;\"><span><span style=\"display:inline-block;width:10px;height:10px;border-radius:3px;background:#ef4444;margin-right:8px;\"></span>Install errors</span><b>@DHPatchNErr</b></div><div style=\"height:12px;background:#f1f5f9;border-radius:6px;\"><div style=\"width:@DHPatchBarErr%;height:12px;background:#ef4444;border-radius:6px;\"></div></div></div><div style=\"margin:0 0 13px;\"><div style=\"display:flex;justify-content:space-between;font-size:13px;color:#334155;margin-bottom:5px;\"><span><span style=\"display:inline-block;width:10px;height:10px;border-radius:3px;background:#f59e0b;margin-right:8px;\"></span>Reboot required</span><b>@DHPatchNRbt</b></div><div style=\"height:12px;background:#f1f5f9;border-radius:6px;\"><div style=\"width:@DHPatchBarRbt%;height:12px;background:#f59e0b;border-radius:6px;\"></div></div></div><div style=\"margin:0 0 13px;\"><div style=\"display:flex;justify-content:space-between;font-size:13px;color:#334155;margin-bottom:5px;\"><span><span style=\"display:inline-block;width:10px;height:10px;border-radius:3px;background:#94a3b8;margin-right:8px;\"></span>No patch policy</span><b>@DHPatchNNone</b></div><div style=\"height:12px;background:#f1f5f9;border-radius:6px;\"><div style=\"width:@DHPatchBarNone%;height:12px;background:#94a3b8;border-radius:6px;\"></div></div></div></div><div style=\"flex:1;min-width:180px;border-left:1px solid #eef2f7;padding-left:20px;\"><div style=\"font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#64748b;font-weight:600;margin-bottom:6px;\">Operating systems</div><div style=\"display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #eef2f7;font-size:13px;\"><span style=\"color:#334155;\">@DHOsName1</span><span><b style=\"color:#0f1f3d;\">@DHOsN1</b> <span style=\"color:#94a3b8;font-size:11px;\">@DHOsPct1%</span></span></div><div style=\"display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #eef2f7;font-size:13px;\"><span style=\"color:#334155;\">@DHOsName2</span><span><b style=\"color:#0f1f3d;\">@DHOsN2</b> <span style=\"color:#94a3b8;font-size:11px;\">@DHOsPct2%</span></span></div><div style=\"display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #eef2f7;font-size:13px;\"><span style=\"color:#334155;\">@DHOsName3</span><span><b style=\"color:#0f1f3d;\">@DHOsN3</b> <span style=\"color:#94a3b8;font-size:11px;\">@DHOsPct3%</span></span></div><div style=\"display:flex;justify-content:space-between;align-items:center;padding:9px 0;border-bottom:1px solid #eef2f7;font-size:13px;\"><span style=\"color:#334155;\">@DHOsName4</span><span><b style=\"color:#0f1f3d;\">@DHOsN4</b> <span style=\"color:#94a3b8;font-size:11px;\">@DHOsPct4%</span></span></div></div></div>"
