{
  "name": "Employee Leave (Microsoft 365)",
  "description": "From the Employee Leave portal form, for a colleague or for yourself: pauses the employee's Microsoft 365 access now or on a chosen start date, turns it back on at the return date, notes the ticket and sends the requester a Signal. A daily Routine with {\"mode\": \"scheduled\"} applies the scheduled changes. No AI.",
  "version": "1.1.0",
  "definition": {
    "schemaVersion": 1,
    "activities": [
      {
        "id": "start",
        "type": "start",
        "name": "Start",
        "position": {
          "x": 100,
          "y": 80
        },
        "properties": {
          "webhookEnabled": false
        }
      },
      {
        "id": "leave",
        "type": "powershell-script",
        "name": "Put the employee on leave",
        "position": {
          "x": 300,
          "y": 80
        },
        "properties": {
          "script": "@file:leave.ps1",
          "timeoutSeconds": 300,
          "retryCount": 0,
          "parameters": [],
          "aiExtensions": [],
          "testInput": "{\n  \"leaveUser\": \"adele.vance@contoso.com\",\n  \"leaveType\": \"Leave of absence\",\n  \"leaveStart\": \"2026-12-01\",\n  \"returnDate\": \"2026-12-15\",\n  \"confirm\": false,\n  \"company\": {\n    \"id\": 1,\n    \"name\": \"Contoso Ltd\",\n    \"tenantId\": \"00000000-0000-0000-0000-000000000000\"\n  }\n}"
        }
      },
      {
        "id": "end",
        "type": "end",
        "name": "End",
        "position": {
          "x": 500,
          "y": 80
        },
        "properties": {}
      }
    ],
    "connections": [
      {
        "source": "start",
        "target": "leave",
        "sourceHandle": null
      },
      {
        "source": "leave",
        "target": "end",
        "sourceHandle": null
      }
    ],
    "startActivityId": "start"
  }
}
