          "testInput": "{\n  \"companyId\": 1,\n  \"psaCompanyId\": 250,\n  \"tenantId\": \"00000000-0000-0000-0000-000000000000\",\n  \"confirm\": false\n}"
        }
      },
      {
        "id": "end",
        "type": "end",
        "name": "End",
        "position": {
          "x": 500,
          "y": 80
        },
        "properties": {}
      }
    ],
    "connections": [
      {
        "source": "start",
        "target": "qbr",
        "sourceHandle": null
      },
      {
        "source": "qbr",
        "target": "end",
        "sourceHandle": null
      }
    ],
    "startActivityId": "start"
  }
