{
  "name": "Software Install (Datto RMM)",
  "description": "From the Request Software portal form: installs the app the client picked on the computer they picked with a Datto RMM ComStore component, waits for the result, notes the ticket and sends the requester a Signal. No AI.",
  "version": "1.0.0",
  "definition": {
    "schemaVersion": 1,
    "activities": [
      {
        "id": "start",
        "type": "start",
        "name": "Start",
        "position": {
          "x": 100,
          "y": 80
        },
        "properties": {
          "webhookEnabled": false
        }
      },
      {
        "id": "install",
        "type": "powershell-script",
        "name": "Install the requested software",
        "position": {
          "x": 300,
          "y": 80
        },
        "properties": {
          "script": "@file:install.ps1",
          "timeoutSeconds": 600,
          "retryCount": 0,
          "parameters": [],
          "aiExtensions": [],
          "testInput": "{\n  \"softwareApp\": \"Google Chrome\",\n  \"deviceName\": \"CONTOSO-LAPTOP-01\",\n  \"confirm\": false,\n  \"ticket\": {\n    \"id\": 0\n  },\n  \"company\": {\n    \"id\": 1,\n    \"name\": \"Contoso Ltd\"\n  },\n  \"user\": {\n    \"id\": \"00000000-0000-0000-0000-000000000000\",\n    \"name\": \"Megan Bowen\"\n  }\n}"
        }
      },
      {
        "id": "end",
        "type": "end",
        "name": "End",
        "position": {
          "x": 500,
          "y": 80
        },
        "properties": {}
      }
    ],
    "connections": [
      {
        "source": "start",
        "target": "install",
        "sourceHandle": null
      },
      {
        "source": "install",
        "target": "end",
        "sourceHandle": null
      }
    ],
    "startActivityId": "start"
  }
}
