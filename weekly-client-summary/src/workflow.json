{
  "name": "Weekly Client Summary (Signal)",
  "description": "Counts a client's ConnectWise tickets for the last 7 days (resolved, still open, waiting on them) and sends the summary to the client as a Signal desktop notice. No AI.",
  "version": "1.0.0",
  "definition": {
    "schemaVersion": 1,
    "activities": [
      {
        "id": "start",
        "type": "start",
        "name": "Start",
        "position": {
          "x": 100,
          "y": 80
        },
        "properties": {
          "webhookEnabled": false
        }
      },
      {
        "id": "summary",
        "type": "powershell-script",
        "name": "Send the weekly ticket summary",
        "position": {
          "x": 300,
          "y": 80
        },
        "properties": {
          "script": "@file:summary.ps1",
          "timeoutSeconds": 180,
          "retryCount": 0,
          "parameters": [],
          "aiExtensions": [],
          "testInput": "{\n  \"companyId\": 1,\n  \"psaCompanyId\": 250,\n  \"users\": [\n    \"00000000-0000-0000-0000-000000000000\"\n  ],\n  \"confirm\": false\n}"
        }
      },
      {
        "id": "end",
        "type": "end",
        "name": "End",
        "position": {
          "x": 500,
          "y": 80
        },
        "properties": {}
      }
    ],
    "connections": [
      {
        "source": "start",
        "target": "summary",
        "sourceHandle": null
      },
      {
        "source": "summary",
        "target": "end",
        "sourceHandle": null
      }
    ],
    "startActivityId": "start"
  }
}
